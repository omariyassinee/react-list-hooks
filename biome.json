{
  "$schema": "https://biomejs.dev/schemas/2.4.10/schema.json",

  "vcs": {
    "enabled": false,

    "clientKind": "git",
    "useIgnoreFile": false
  },

  "formatter": {
    "enabled": true,
    "indentStyle": "tab"
  },

  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "noUnusedVariables": "warn"
      },
      "suspicious": {
        "noArrayIndexKey": "off"
      },
      "complexity": {
        "useArrowFunction": "off"
      }
    }
  },

  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true,
      "indentStyle": "tab",
      "lineWidth": 220
    }
  },

  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },

  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "indentStyle": "tab",
      "indentWidth": 2,

      "lineWidth": 110
    }
  },

  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  }
}

{
	"name": "@omariyassine/react-list-hooks",
	"version": "0.2.0",
	"description": "A generic React hook for paginating arrays with full navigation controls",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./use-paginator": {
			"import": {
				"types": "./dist/use-paginator.d.ts",
				"default": "./dist/use-paginator.js"
			},
			"require": {
				"types": "./dist/use-paginator.d.cts",
				"default": "./dist/use-paginator.cjs"
			}
		},
		"./use-filter": {
			"import": {
				"types": "./dist/use-filter.d.ts",
				"default": "./dist/use-filter.js"
			},
			"require": {
				"types": "./dist/use-filter.d.cts",
				"default": "./dist/use-filter.cjs"
			}
		},
		"./use-sort": {
			"import": {
				"types": "./dist/use-sort.d.ts",
				"default": "./dist/use-sort.js"
			},
			"require": {
				"types": "./dist/use-sort.d.cts",
				"default": "./dist/use-sort.cjs"
			}
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsup",
		"test": "bun test",
		"prepublishOnly": "bun run build"
	},
	"peerDependencies": {
		"react": ">=18"
	},
	"devDependencies": {
		"@testing-library/react": "^16.3.2",
		"@types/bun": "^1.3.14",
		"@types/react": "^19.2.18",
		"happy-dom": "^20.11.2",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tsup": "^8.5.1",
		"typescript": "5.7.3"
	},
	"keywords": [
		"react",
		"hook",
		"pagination",
		"paginator",
		"usePaginator"
	],
	"license": "MIT"
}

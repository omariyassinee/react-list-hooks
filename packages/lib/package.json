{
	"name": "@omariyassine/react-list-hooks",
	"version": "0.3.1",
	"description": "A generic, high-performance collection of React hooks for paginating, sorting, and filtering arrays with URL synchronization and 100k+ item support",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/omariyassinee/react-list-hooks.git"
	},
	"homepage": "https://github.com/omariyassinee/react-list-hooks#readme",
	"bugs": {
		"url": "https://github.com/omariyassinee/react-list-hooks/issues"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./use-paginate": {
			"import": {
				"types": "./dist/use-paginate.d.ts",
				"default": "./dist/use-paginate.js"
			},
			"require": {
				"types": "./dist/use-paginate.d.cts",
				"default": "./dist/use-paginate.cjs"
			}
		},
		"./use-filter": {
			"import": {
				"types": "./dist/use-filter.d.ts",
				"default": "./dist/use-filter.js"
			},
			"require": {
				"types": "./dist/use-filter.d.cts",
				"default": "./dist/use-filter.cjs"
			}
		},
		"./use-sort": {
			"import": {
				"types": "./dist/use-sort.d.ts",
				"default": "./dist/use-sort.js"
			},
			"require": {
				"types": "./dist/use-sort.d.cts",
				"default": "./dist/use-sort.cjs"
			}
		},
		"./use-list": {
			"import": {
				"types": "./dist/use-list.d.ts",
				"default": "./dist/use-list.js"
			},
			"require": {
				"types": "./dist/use-list.d.cts",
				"default": "./dist/use-list.cjs"
			}
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsup",
		"test": "bun test",
		"typecheck": "bunx @typescript/native-preview --noEmit",
		"prepublishOnly": "bun run build"
	},
	"peerDependencies": {
		"react": ">=18"
	},
	"devDependencies": {
		"@testing-library/react": "^16.3.2",
		"@types/bun": "^1.3.14",
		"@types/react": "^19.2.18",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"happy-dom": "^20.11.2",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tsup": "^8.5.1",
		"typescript": "5.7.3"
	},
	"keywords": [
		"react",
		"hooks",
		"pagination",
		"paginate",
		"usePaginate",
		"sort",
		"sorting",
		"useSort",
		"filter",
		"filtering",
		"useFilter",
		"list",
		"useList",
		"url-sync"
	],
	"license": "MIT"
}
